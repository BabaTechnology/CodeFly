# Comma-separated local listen addresses. Supports IPv4, IPv6, and local hostnames.
# 0.0.0.0 listens on all IPv4 interfaces. :: listens on all IPv6 interfaces.
HOST_CLIENT_BIND=0.0.0.0
HOST_CLIENT_PORT=7788
HOST_CLIENT_DATA_DIR=/var/lib/codefly/host
HOST_CLIENT_NAME=CodeFly Remote Host
# Address advertised to the phone. Supports IPv4, IPv6, and DNS names without protocol, path, or port.
HOST_CLIENT_DIRECT_PUBLIC_HOST=host.example.com
# Provider workspace. Defaults to the service user's home directory when omitted.
HOST_CLIENT_WORKSPACE_DIR=/home/codefly
HOST_CLIENT_ADAPTER=multi

# Codex adapter
# CODEX_BASE_URL=https://right.codes/codex
# CODEX_MODEL=gpt-5.4-mini
# CODEX_API_KEY=sk_xxx
# CODEX_PROVIDER_NAME=rightcode
# CODEX_HOME_DIR=/home/codefly
# Defaults to the host OS home so CodeFly shares Codex config and session history with other Codex clients on the machine.
# CODEX_APPROVAL_POLICY=on-request
# CODEX_SANDBOX=danger-full-access

# Claude adapter
# CLAUDE_BASE_URL=https://right.codes/claude
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_API_KEY=sk_xxx
# CLAUDE_HOME_DIR=/home/codefly
# Defaults to the host OS home so CodeFly shares Claude Code config and session history with other Claude clients on the machine.
# CLAUDE_PERMISSION_MODE=default
# CLAUDE_DISABLE_NONESSENTIAL_TRAFFIC=1
# CLAUDE_DISABLE_EXPERIMENTAL_BETAS=0

# Optional shared provider key used as a fallback for both Codex and Claude Code.
# PROVIDER_API_KEY=sk_xxx

# RELAY_URL=https://relay.codefly.run
# RELAY_HOST_CREDENTIAL=host_xxx
